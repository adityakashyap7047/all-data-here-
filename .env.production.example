# ============================================
# Notixcloud — Production Environment Variables
# ============================================
# Copy this file to .env.production and fill in your values.

# ---- Database ----
DB_USER=notixcloud
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DATABASE_URL="postgresql://notixcloud:CHANGE_ME_STRONG_PASSWORD_HERE@db:5432/notixcloud?schema=public"

# ---- App ----
NODE_ENV=production
APP_URL="https://notixnode.online"

# ---- Auth ----
AUTH_SECRET="GENERATE_WITH: openssl rand -base64 32"
AUTH_URL="https://notixnode.online"
JWT_SECRET="GENERATE_WITH: openssl rand -base64 32"
JWT_EXPIRES_IN="7d"

# ---- OAuth Providers ----
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ---- Email (SMTP) ----
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="password"
EMAIL_FROM="noreply@notixnode.online"

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ---- Redis ----
REDIS_URL="redis://redis:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Cloudflare Tunnel ----
# Get this from: Cloudflare Dashboard → Zero Trust → Networks → Tunnels → Create
CLOUDFLARE_TUNNEL_TOKEN=""

# ---- Monitoring ----
SENTRY_DSN=""
